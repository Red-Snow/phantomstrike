# PhantomStrike AI — Environment Configuration
# Copy this file to .env and modify as needed.

# ── Server ─────────────────────────────────────────────────────────────
PHANTOMSTRIKE_HOST=127.0.0.1
PHANTOMSTRIKE_PORT=8443
PHANTOMSTRIKE_RELOAD=false

# ── Authentication ────────────────────────────────────────────────────
# REQUIRED. The server refuses to start when auth is enabled with no keys set —
# an API that looks protected but accepts everyone is worse than one that is
# openly unauthenticated.
#
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PHANTOMSTRIKE_AUTH_ENABLED=true
PHANTOMSTRIKE_API_KEYS=CHANGE_ME_generate_a_real_key

# Secret for JWT token signing (auto-generated if not set)
# PHANTOMSTRIKE_SECRET_KEY=your-secret-key

# ── Cross-origin access ──────────────────────────────────────────────
# Empty by default, and "*" is rejected outright. This API executes commands,
# and localhost is reachable from every tab in your browser — a wildcard here
# lets any site you visit drive the server. CLI and MCP clients send no Origin
# header and are unaffected by this setting.
# PHANTOMSTRIKE_CORS_ORIGINS=http://localhost:3000

# ── Engagement scope ─────────────────────────────────────────────────
# Path to your authorised scope file. Targets are checked against it before any
# command is built. Without it the server runs unscoped and warns at startup.
# See engagement.example.yaml.
# PHANTOMSTRIKE_ENGAGEMENT=./engagement.yaml
PHANTOMSTRIKE_ENFORCE_SCOPE=true

# ── Execution ───────────────────────────────────────────────────────
PHANTOMSTRIKE_MAX_JOBS=5
PHANTOMSTRIKE_TIMEOUT=600
PHANTOMSTRIKE_DOCKER_SANDBOX=false

# Arbitrary shell execution (kali_shell plugin). Runs ANY command and bypasses
# every input validator in utils/validation.py. Left off, the plugin is not
# registered at all and never appears in the tool list an AI agent can see.
# Enable only on a disposable host, and read the threat model in SECURITY.md —
# an agent reading attacker-controlled scan output is the caller here.
PHANTOMSTRIKE_ALLOW_RAW_SHELL=false
PHANTOMSTRIKE_WORKSPACE=/tmp/phantomstrike

# ── Database ────────────────────────────────────────────────────────
# Default: SQLite in ~/.phantomstrike/phantomstrike.db
# PHANTOMSTRIKE_DB_URL=sqlite+aiosqlite:///path/to/db

# ── Logging ─────────────────────────────────────────────────────────
PHANTOMSTRIKE_LOG_LEVEL=INFO
# PHANTOMSTRIKE_LOG_FILE=/var/log/phantomstrike.log
